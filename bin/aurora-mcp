#!/bin/sh
set -eu

ROOT="$(CDPATH= cd "$(dirname "$0")/.." && pwd)"
ACTION="${1:-serve}"

usage() {
  cat <<'EOF'
Usage: bin/aurora-mcp [--install | --check | --config PATH | --approve PLAN_ID]

--install     Prepare/reuse the minimal external MCP environment and configuration.
--check       Prepare the minimal setup and run doctor without starting MCP.
--config PATH Use an external local workflow configuration.
--approve ID  Human-only interactive approval using the same setup and configuration.

Normal startup connects immediately and prepares minimal dependencies in the background.
Settings: ~/.config/aurora/launcher.json; see docs/claude-code-plugin.md.
EOF
}

die() {
  printf '[aurora-mcp] %s\n' "$*" >&2
  exit 2
}

case "$ACTION" in
  --help|-h)
    usage
    exit 0
    ;;
  --config|--approve)
    [ "$#" -eq 2 ] || die "$ACTION requires an argument"
    if [ "$ACTION" = "--config" ]; then
      export AURORA_WORKFLOW_CONFIG="$2"
      ACTION="serve"
    else
      export AURORA_APPROVE_PLAN="$2"
    fi
    ;;
  --install|--check)
    [ "$#" -eq 1 ] || die "Unexpected arguments; see --help"
    ;;
  serve)
    [ "$#" -eq 0 ] || die "Unexpected arguments; see --help"
    ;;
  *)
    die "Unknown option: $ACTION"
    ;;
esac

if [ -n "${AURORA_WORKFLOW_DOCKER_IMAGE:-}" ]; then
  command -v docker >/dev/null 2>&1 || die "Docker mode is enabled but docker was not found."
  [ -n "${AURORA_WORKSPACE:-}" ] && [ -d "$AURORA_WORKSPACE" ] ||
    die "Set AURORA_WORKSPACE to the host directory mounted as /workspace."
  [ -n "${AURORA_WORKFLOW_DOCKER_CONFIG:-}" ] && [ -f "$AURORA_WORKFLOW_DOCKER_CONFIG" ] ||
    die "Set AURORA_WORKFLOW_DOCKER_CONFIG to the container-path config created by the runbook."

  set -- docker run --rm -i --init \
    --user "$(id -u):$(id -g)" \
    --mount "type=bind,src=$(CDPATH= cd "$AURORA_WORKSPACE" && pwd),dst=/workspace" \
    --mount "type=bind,src=$(CDPATH= cd "$(dirname "$AURORA_WORKFLOW_DOCKER_CONFIG")" && pwd)/$(basename "$AURORA_WORKFLOW_DOCKER_CONFIG"),dst=/config/workflow.json,readonly" \
    -e AURORA_WORKFLOW_CONFIG=/config/workflow.json \
    -e CDSAPI_RC=/config/ads.credentials \
    -e HOME=/tmp
  ads_config="${CDSAPI_RC:-$HOME/.cdsapirc}"
  if [ -f "$ads_config" ]; then
    set -- "$@" --mount "type=bind,src=$(CDPATH= cd "$(dirname "$ads_config")" && pwd)/$(basename "$ads_config"),dst=/config/ads.credentials,readonly"
  fi
  set -- "$@" "$AURORA_WORKFLOW_DOCKER_IMAGE"
  if [ "$ACTION" != "serve" ]; then
    set -- "$@" "$ACTION"
    if [ "$ACTION" = "--approve" ]; then
      set -- "$@" "$AURORA_APPROVE_PLAN"
    fi
  fi
  exec "$@"
fi

python_bin=""
if [ -n "${AURORA_PYTHON:-}" ]; then
  candidates="$AURORA_PYTHON"
else
  candidates=""
fi
for candidate in "$candidates" "${AURORA_WORKFLOW_VENV:+$AURORA_WORKFLOW_VENV/bin/python}" python3.12 python3.13 python3.14 python3 python; do
    [ -n "$candidate" ] || continue
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c 'import sys; sys.exit(0 if (3, 12) <= sys.version_info[:2] <= (3, 14) else 1)' 2>/dev/null; then
      python_bin="$(command -v "$candidate")"
      break
    fi
done
[ -n "$python_bin" ] || die "Python 3.12–3.14 is missing from this client's PATH. Install Python with venv/pip support, restart the client, or set AURORA_PYTHON to its absolute executable in the MCP environment. Then reconnect; no clone or manual environment is needed."
exec "$python_bin" "$ROOT/scripts/launch_workflow.py" "$ACTION"
